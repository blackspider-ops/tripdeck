{
  "name": "@all-ayes/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "tsx src/index.ts",
    "build": "node scripts/build.mjs",
    "start:prod": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "warm-voices": "tsx scripts/warm-voice-cache.ts"
  },
  "dependencies": {
    "@all-ayes/shared": "*",
    "@google/genai": "^1.0.0",
    "@simplewebauthn/server": "^13.3.3",
    "express": "^5.1.0",
    "mongodb": "^6.10.0",
    "nanoid": "^5.0.9",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
