# All Ayes — copy to .env and fill what you have. Everything is optional:
# without keys the app still runs end to end (rule-based lines, captions + browser voices, in-memory DB, simulated Visa).

PORT=8787
# SEC-013: a PUBLIC_BASE_URL on a real host (not localhost) makes this a production server, whatever NODE_ENV says:
# HSTS on, dev routes locked behind DEV_KEY, passkeys pinned to this origin. Leave it empty for local development.
PUBLIC_BASE_URL=
# APP_ENV: production | development. `npm run dev` counts as development (demo seeding and /api/debug open without the
# key, but only to a client on this machine: through a tunnel or from the LAN they still need DEV_KEY).
# APP_ENV=development also keeps a tunnel PUBLIC_BASE_URL out of production mode. Don't set NODE_ENV here.
APP_ENV=
# Unlocks /api/demo/seed, /api/debug and /api/health details (header X-Dev-Key) outside dev mode. Production refuses
# to start with a key shorter than 32 characters (e.g. `openssl rand -hex 24`); empty = dev routes off.
# In a browser, open /demo#key=<DEV_KEY> once (the fragment only; ?key= is ignored because it lands in request logs).
DEV_KEY=
CORS_ORIGINS=                     # extra browser origins allowed to open a socket (comma-separated); the page's own origin always is
SERVE_WEB=                        # 1 = serve apps/web/dist from this server outside production too (dev normally uses Vite on :5173)
WEB_DIST=                         # where the built web app is (default apps/web/dist)
PAIRING_SECRET=                   # HMAC key for headset pair codes; unset = random per process (codes die on restart)

# Passkeys (default: PUBLIC_BASE_URL in production; the request's origin in development)
WEBAUTHN_ORIGIN=                  # e.g. https://<name>.trycloudflare.com while testing on a tunnel
WEBAUTHN_RP_ID=                   # defaults to WEBAUTHN_ORIGIN's host

# Storage (DEPLOY.md "Storage")
DATA_DIR=                         # default apps/server/data — local memory when MongoDB is off; point at a persistent disk
CACHE_DIR=                        # default apps/server/.cache — regenerable voice cache
RESTORE_RECENT_DAYS=7             # settled voyages younger than this are reloaded at boot

# MongoDB Atlas (MLH: Best Use of MongoDB Atlas)
MONGODB_URI=
MONGODB_DB=all_ayes

# Gemini (MLH: Best Use of Gemini API) — use a billing-enabled key so rate limits don't stall the demo
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AGENT_DECISIONS=rules             # rules = protocol decides moves, Gemini writes every line · model = Gemini may choose moves too

# ElevenLabs (MLH: Best Use of ElevenLabs) — voices per crew band + Captain, and hail transcription
ELEVENLABS_API_KEY=
ELEVEN_MODEL=eleven_flash_v2_5
ELEVEN_STT_MODEL=scribe_v1        # spoken hails → text
# Voices: blank = default (premade voices every account has, free plan included — library voices 402 on free plans):
# Captain George · band 1 Liam · 2 Sarah · 3 Chris · 4 Jessica (doc 05 §8). Set a voice ID to override.
ELEVEN_VOICE_CAPTAIN=
ELEVEN_VOICE_BAND1=
ELEVEN_VOICE_BAND2=
ELEVEN_VOICE_BAND3=
ELEVEN_VOICE_BAND4=

# Backboard memory (MLH: Best Use of Backboard, promo 13HACKGT) — confirm REST paths in src/memory/memory.ts
BACKBOARD_API_KEY=
BACKBOARD_BASE_URL=

# RouteStack.ai live inventory (docs/12-routestack.md): real hotels + flights for the chart; without keys (or on any
# error / timeout / spent budget) the curated and modelled data are used. Keys from the RouteStack dashboard.
ROUTESTACK_API_KEY=
ROUTESTACK_API_SECRET=
ROUTESTACK_ACCOUNT_ID=              # informational (partner-token auth derives the account)
ROUTESTACK_MODE=                    # off | sandbox | live; blank = sandbox when both keys are set, else off
ROUTESTACK_BASE_URL=                # blank = https://evolvemcp.routestack.ai (sandbox), or https://mcp.routestack.ai when MODE=live
ROUTESTACK_DAILY_CAP=200            # billable searches (hotel/flight) per UTC day, whole server; 0 = off
ROUTESTACK_TRIP_CAP=20              # billable searches per voyage
ROUTESTACK_SEARCH_TIMEOUT_MS=90000  # we give up on a search after this (RouteStack's own default is 180 s)
ROUTESTACK_TIMEOUT_MS=30000         # token / destination lookup / flight session
ROUTESTACK_CACHE_HOURS=6            # the same search within this window is answered from the cache (never billed twice)

# Visa Intelligent Commerce (doc 06). sim = simulated with identical flow; visa_sandbox once visaVic.ts is wired
PAYMENTS_MODE=sim
VISA_VIC_API_BASE=
VISA_VIC_API_KEY=
SIM_DECLINE_MEMBER=
SIM_TIMEOUT_MEMBER=
SEAL_DEADLINE_MS=600000           # how long the crew has to set their seals once the Captain calls for them
# (the 2.5 s settle point after the last seal, doc 06 §4.2, is fixed in code and scaled only by PACE_SCALE)
TABLE_RUNS_MAX=6                  # table meetings per voyage; after that table:start is refused with TOO_MANY_RUNS

# Demo
EXPO_MODE=true                    # ≤20-word lines + faster voices so the table fits ~60–70 s
PACE_SCALE=1                      # pacing multiplier for the table and the seal settle point (tests use 0)
DEMO_REPLAY=live                  # cached = the Expo emergency button: no model calls, voices only from the warmed cache

# Limits (docs/04 §12 "Limits") — all optional
TRUST_PROXY_HOPS=                 # proxies in front; unset = 1 on Render/Fly, else 0 (X-Forwarded-For ignored)
RATE_LIMITS=on                    # off = no rate limits (load tests only)
RATE_LIMIT_SCALE=1
HAIL_AUDIO_MAX_BYTES=524288
DAILY_CAP_GEMINI=3000             # paid calls per UTC day; over it → templates/captions/typed hails/local memory; 0 = off
DAILY_CAP_TTS=1500
DAILY_CAP_STT=500
DAILY_CAP_BACKBOARD=3000
TRIP_CAP_GEMINI=150               # paid calls per voyage
TRIP_CAP_TTS=100
TRIP_CAP_STT=30
TRIP_CAP_BACKBOARD=60
VOYAGE_IDLE_HOURS=48              # idle voyages leave memory (BRIEFING); BOOKED/VOIDED after VOYAGE_DONE_DAYS
VOYAGE_DONE_DAYS=7
VOYAGE_LONE_HOURS=1               # a BRIEFING voyage nobody joined (≤ 1 seat, nothing sealed) leaves memory after this (sweep every 15 min)
VOYAGE_STALE_DAYS=30              # an untouched Dry Run leaves memory, and isn't loaded at boot (opens again by code)
MAX_LIVE_VOYAGES=2000             # voyages in memory at once; past it new ones get 503 HELM_FULL (0 = no cap)
CREATE_RATE_GLOBAL=60             # new voyages per minute, whole server
CREATE_RATE_48=30                 # new voyages per minute per IPv6 /48 (per address it's 10)
SPEND_RESERVE_PCT=20              # share of each DAILY_CAP_* kept for voyages past the table (Dry Run/sealing/booked)
TRIP_MISS_RATE=20                 # unknown voyage ids per minute per address on /api/trips/:id/* (each is a DB lookup)
PAIR_FAIL_RATE_48=30              # wrong headset codes per minute per IPv6 /48 (per address it's 10; no global cap)
TTS_CACHE_MAX_FILES=3000
TTS_CACHE_MAX_DAYS=30

# Client (Vite) — this root .env is read by Vite too (envDir); only VITE_* names are exposed to browsers, at build time
# Both tile tokens ship in the public bundle: restrict them at the provider (DEPLOY.md "Browser tile tokens")
VITE_GOOGLE_MAP_TILES_KEY=        # Google Photorealistic 3D Tiles for the Dry Run; restrict by HTTP referrer + Map Tiles API only
VITE_CESIUM_ION_TOKEN=            # no-card alternative: the same Google 3D tiles via a free Cesium ion account (scope assets:read, asset 2275207, allowed URLs)

# Web dev/build (read by apps/web/vite.config.ts, never shipped to browsers)
API_URL=                          # where Vite proxies /api and /socket.io (default http://localhost:8787)
VITE_ALLOWED_HOSTS=               # extra hosts the Vite dev server answers (localhost and *.trycloudflare.com always are)
VITE_SOURCEMAP=                   # off = no source maps at all (default: hidden maps, never referenced or served)
